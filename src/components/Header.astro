---
const navLinks = [
  { href: "#about", label: "About Me" },
  { href: "#research", label: "Research" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#cv", label: "CV" },
];
---

<header class="site-header">
  <div class="site-shell nav-row">

    <!-- Mobile only: name, no nav dropdown -->
    <span class="mobile-name">Akarshan Shrestha</span>

    <!-- Desktop only: nav links -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a class="nav-link" href={link.href}>{link.label}</a>
      ))}
    </nav>

    <!-- Theme toggle: always visible -->
    <button type="button" class="theme-button" aria-label="Toggle color theme" id="theme-toggle">
      <!-- Sun: shown in light mode -->
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        class="icon-sun" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path><path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path><path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <!-- Moon: shown in dark mode -->
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        class="icon-moon" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>

  </div>
</header>

<style is:global>
  /* Mobile name: hidden on desktop */
  .mobile-name {
    display: none;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  @media (max-width: 600px) {
    .desktop-nav { display: none; }
    .mobile-name { display: block; }
  }

  /* Sun = light mode, Moon = dark mode */
  [data-theme="light"] .icon-sun  { display: block; }
  [data-theme="light"] .icon-moon { display: none;  }
  [data-theme="dark"]  .icon-sun  { display: none;  }
  [data-theme="dark"]  .icon-moon { display: block; }

  /* Before JS sets data-theme, assume light */
  :root:not([data-theme]) .icon-sun  { display: block; }
  :root:not([data-theme]) .icon-moon { display: none;  }
</style>

<script>
  function applyTheme(theme: string) {
    document.documentElement.setAttribute("data-theme", theme);
    try { localStorage.setItem("theme", theme); } catch (_) {}
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute("data-theme") || "light";
    applyTheme(current === "dark" ? "light" : "dark");
  }

  document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
</script>
