---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// ── Hero ─────────────────────────────────────────────────────
const heroEyebrow = "Web & Mobile Development · React Ecosystem";
const heroName = "Akarshan Sekhar Shrestha";
const heroThesis =
  "I enjoy carving out new solutions and optimizing pre-existing ones. My design language is functionality paired with efficiency.";
const heroSupport =
  "Currently, I'm studying AWS and CloudOps to understand what's powering modern web applications and cloud computing architectures.";
const heroLinks = [
  {
    href: "mailto:akarshanshrestha@gmail.com",
    label: "akarshanshrestha@gmail.com",
    external: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
  {
    href: "/CV - Akarshan Sekhar Shrestha.pdf",
    label: "Curriculum Vitae",
    external: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`,
  },
  {
    href: "https://github.com/aku47z",
    label: "GitHub",
    external: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
  },
  {
    href: "https://linkedin.com/in/akarshan.shrestha",
    label: "LinkedIn",
    external: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
];

// ── Skills ────────────────────────────────────────────────────
const skillGroups = [
  {
    category: "Languages",
    items: ["JavaScript", "TypeScript", "Python", "C"],
  },
  {
    category: "Frameworks & Libraries",
    items: ["React", "Next.js", "Astro", "Refine", "React Native", "Expo", "Node.js", "Flask"],
  },
  {
    category: "Infrastructure & Tools",
    items: ["Cloudflare",  "Firebase", "Supabase", "SQLite", "Postgres", "Git", "Bash", "Docker", "Figma"],
  },
];

// ── Research ──────────────────────────────────────────────────
const publications = [
  {
    year: 2025,
    venue: "National Conference on Computer Innovations",
    status: "Published",
    title: "Multi-Stage Fine-Tuning of mT5-Small for Nepali News Summarization",
    authors: "Akarshan Sekhar Shrestha, Albina Shrestha, Arnav Bhatta, Yunika Bhochhibhoya, Sophiya Shrestha, Prakash Poudyal",
    summary: "This research explored low-resource fine-tuning of the multilingual text-to-text transformer model, mT5-small, for short-length abstractive summarization task in the Nepali language. The dataset used for the fine-tuning process was a custom dataset collected by extensively scraping Nepali news websites.",
    highlight: "This work signifies the value of specialized model training methods for low-resource environments, with proven results.",
    links: [{ href: "https://conf.kucc.ku.edu.np/uploads/archive/1770520316100-KUSET-Multi-Stage-Fine-Tuning-of-mT5-Small-for-Nepali-News-Summarization-Akarshan-Shrestha.pdf", label: "Paper" }],
  }
];

// ── Projects ───────────────────────────────────────────────────
const projects = [
  {
    type: "Website",
    status: "Deployed",
    title: "mechicarpet.com",
    description:
      "A freelance website showcasing the craftsmanship and catalogue of Tibetan rugs provided by Mechi Surshar Carpets Industries.",
    tags: ["Astro", "HTML", "CSS", "JavaScript", "Cloudflare", "SEO"],
    links: [{ href: "https://mechicarpet.com", label: "Link" }],
  },
  {
    type: "Mobile Application",
    status: "Active",
    title: "Doo",
    description:
      "Doo is a Google Classroom wrapper with a more elegant, intuitive UI and additional features, made using React Native on top of Expo.",
    tags: ["React Native", "Expo", , "SQLite", "Google Cloud"],
    links: [
      { href: "https://github.com/aku47z/doo", label: "Repository" },
    ]
  },
  {
    type: "NPM Package",
    status: "Archived",
    title: "pretext-rn",
    description:
    "Synchronous text height measurement for React Native via JSI. Inspired by Cheng Lou's pretext.",
    tags: ["React Native/Expo", "JSI", "NPM"],
    links: [
      { href: "https://github.com/aku47z/pretext-rn", label: "Repository" },
      { href: "https://www.npmjs.com/package/pretext-rn", label: "NPM Registry"},
    ]
  },

];



---

<Layout
  title="Akarshan Sekhar Shrestha"
  description={heroSupport}
>
  <Header />

  <main class="site-main">

    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="hero" id="about">
      <div class="site-shell">
        <p class="eyebrow">{heroEyebrow}</p>
        <h1>{heroName}</h1>
        <p class="hero-thesis">{heroThesis}</p>
        <p class="hero-support">{heroSupport}</p>
        <div class="hero-meta">
          {heroLinks.map((link) => (
            <a
              class="text-link hero-link"
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              <Fragment set:html={link.icon} />
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Research ───────────────────────────────────────────── -->
    <section class="section" id="research">
      <div class="site-shell section-grid">
        <h2 class="section-label">Research</h2>
        <div class="record-list">
          {publications.map((pub) => (
            <article class="record">
              <div class="record-meta">
                <div>{pub.year}</div>
                <div>{pub.venue}</div>
              </div>
              <div>
                <span class="status">{pub.status}</span>
                <h3 class="record-title">{pub.title}</h3>
                {/* <p class="record-authors">{pub.authors}</p> */}
                <p class="record-copy">{pub.summary}</p>
                <p class="record-copy">
                  <strong>Highlight: </strong>{pub.highlight}
                </p>
                <div class="link-row">
                  {pub.links.map((l) => (
                    <a class="text-link" href={l.href} target="_blank" rel="noopener noreferrer">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Projects ──────────────────────────────────────────── -->
    <section class="section" id="projects">
      <div class="site-shell section-grid">
        <h2 class="section-label">Projects</h2>
        <div class="record-list">
          {projects.map((proj) => (
            <article class="record">
              <div class="record-meta">
                <div>{proj.type}</div>
              </div>
              <div>
                <span class="status">{proj.status}</span>
                <h3 class="record-title">{proj.title}</h3>
                <p class="record-copy">{proj.description}</p>
                <div class="tag-row" aria-label="Technologies">
                  {proj.tags.map((tag) => (
                    <span class="status">{tag}</span>
                  ))}
                </div>
                <div class="link-row">
                  {proj.links.map((l) => (
                    <a class="text-link" href={l.href} target="_blank" rel="noopener noreferrer">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Skills ────────────────────────────────────────────── -->
    <section class="section" id="skills">
      <div class="site-shell section-grid">
        <h2 class="section-label">Skills</h2>
        <div class="record-list">
          {skillGroups.map((group) => (
            <article class="record">
              <div class="record-meta">
                <div>{group.category}</div>
              </div>
              <div class="tag-row">
                {group.items.map((item) => (
                  <span class="status">{item}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CV ────────────────────────────────────────────────── -->
    <section class="section" id="cv">
      <div class="site-shell section-grid">
        <h2 class="section-label">CV</h2>
        <div class="link-row">
          <a class="text-link" href="/CV - Akarshan Sekhar Shrestha.pdf" target="_blank" rel="noopener noreferrer">View or Download PDF</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
